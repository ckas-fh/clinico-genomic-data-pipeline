# ---- Data safety: never commit raw or patient data ----
data/raw/
data/interim/
data/processed/
*.vcf
*.vcf.gz
*.bam
*.bai
*.cram
*.fastq
*.fastq.gz
*.parquet
*.csv
*.tsv
*.xlsx
